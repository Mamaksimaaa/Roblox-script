local function Create(class, props, children)
    local inst = Instance.new(class)
    for k, v in pairs(props or {}) do
        if k ~= "Parent" then
            inst[k] = v
        end
    end
    for _, child in ipairs(children or {}) do
        child.Parent = inst
    end
    if props and props.Parent then
        inst.Parent = props.Parent
    end
    return inst
end

local function Tween(inst, props, time, style, direction)
    local info = TweenInfo.new(
        time or 0.2,
        style or Enum.EasingStyle.Quart,
        direction or Enum.EasingDirection.Out
    )
    TweenService:Create(inst, info, props):Play()
end

-- Перетаскивание окна мышью И пальцем (тач)
local function MakeDraggable(frame, handle)
    handle = handle or frame
    local dragging, dragInputId, dragStart, startPos = false, nil, nil, nil

    local function BeginDrag(input)
        dragging   = true
        dragInputId = input.UserInputType
        dragStart  = input.Position
        startPos   = frame.Position
    end

    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            BeginDrag(input)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(
                startPos.X.Scale,
                startPos.X.Offset + delta.X,
                startPos.Y.Scale,
                startPos.Y.Offset + delta.Y
            )
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
end

-- Классическая врезанная (bevel) Minecraft-рамка: чёрный контур +
-- светлая грань сверху/слева + тёмная грань снизу/справа
local function PixelBevel(frame, theme, thickness)
    thickness = thickness or 2
    Create("UIStroke", {Color = theme.Border, Thickness = thickness, Parent = frame})
    local z = (frame.ZIndex or 1) + 1
    local top = Create("Frame", {
        Name = "BevelTop", BackgroundColor3 = theme.BevelLight, BorderSizePixel = 0,
        Size = UDim2.new(1, -thickness * 2, 0, 1),
        Position = UDim2.new(0, thickness, 0, thickness),
        ZIndex = z, Parent = frame,
    })
    local left = Create("Frame", {
        Name = "BevelLeft", BackgroundColor3 = theme.BevelLight, BorderSizePixel = 0,
        Size = UDim2.new(0, 1, 1, -thickness * 2),
        Position = UDim2.new(0, thickness, 0, thickness),
        ZIndex = z, Parent = frame,
    })
    local bottom = Create("Frame", {
        Name = "BevelBottom", BackgroundColor3 = theme.BevelDark, BorderSizePixel = 0,
        Size = UDim2.new(1, -thickness * 2, 0, 1),
        Position = UDim2.new(0, thickness, 1, -thickness - 1),
        ZIndex = z, Parent = frame,
    })
    local right = Create("Frame", {
        Name = "BevelRight", BackgroundColor3 = theme.BevelDark, BorderSizePixel = 0,
        Size = UDim2.new(0, 1, 1, -thickness * 2),
        Position = UDim2.new(1, -thickness - 1, 0, thickness),
        ZIndex = z, Parent = frame,
    })
    return {top = top, left = left, bottom = bottom, right = right}
end

-- Пиксельный текст: жирная тень как в шрифте Minecraft
local function PixelText(label, color)
    label.TextStrokeTransparency = 0
    label.TextStrokeColor3 = Color3.fromRGB(20, 18, 14)
    if color then label.TextColor3 = color end
end

local function AddCorner(frame, radius)
    return Create("UICorner", { CornerRadius = UDim.new(0, radius or 0), Parent = frame })
end

local function AddPadding(frame, t, b, l, r)
    return Create("UIPadding", {
        PaddingTop = UDim.new(0, t or 6), PaddingBottom = UDim.new(0, b or 6),
        PaddingLeft = UDim.new(0, l or 8), PaddingRight = UDim.new(0, r or 8),
        Parent = frame,
    })
end

-- Блочная "шумовая" текстура фона (как земля/камень) — лёгкая шахматка
local function AddBlockTexture(parent, theme, cellsX, cellsY, transparency)
    local grid = Create("Frame", {
        Name = "BlockTexture", Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1, ZIndex = 0, ClipsDescendants = true,
        Parent = parent,
    })
    local cw, ch = 1 / cellsX, 1 / cellsY
    for y = 0, cellsY - 1 do
        for x = 0, cellsX - 1 do
            local even = (x + y) % 2 == 0
            Create("Frame", {
                Size = UDim2.new(cw, 0, ch, 0),
                Position = UDim2.new(x * cw, 0, y * ch, 0),
                BackgroundColor3 = even and theme.TextureA or theme.TextureB,
                BackgroundTransparency = transparency or 0,
                BorderSizePixel = 0, ZIndex = 0,
                Parent = grid,
            })
        end
    end
    return grid
end

