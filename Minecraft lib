    function self:AddTab(name)
        local t = self._theme
        local mobile = self._mobile

        local TabBtn = Create("TextButton", {
            Name = "Tab_" .. name, Size = UDim2.new(1, 0, 0, mobile and 34 or 30),
            BackgroundColor3 = t.TabInactive, Text = name,
            TextColor3 = t.TextSecondary, TextSize = FONT_BODY,
            Font = Enum.Font.Code, BorderSizePixel = 0,
            LayoutOrder = #self._tabs + 1, ZIndex = 4, Parent = self._tabList,
        })
        PixelText(TabBtn)
        PixelBevel(TabBtn, t, 1)

        local ActiveBar = Create("Frame", {
            Name = "ActiveBar", Size = UDim2.new(0, 3, 1, 0),
            BackgroundColor3 = t.Accent, BorderSizePixel = 0,
            Visible = false, ZIndex = 6, Parent = TabBtn,
        })

        local ContentScroll = Create("ScrollingFrame", {
            Name = "TabContent_" .. name, Size = UDim2.new(1, 0, 1, 0),
            BackgroundTransparency = 1, BorderSizePixel = 0,
            ScrollBarThickness = mobile and 5 or 4,
            ScrollBarImageColor3 = t.Scrollbar,
            CanvasSize = UDim2.new(0, 0, 0, 0),
            AutomaticCanvasSize = Enum.AutomaticSize.Y,
            Visible = false, ZIndex = 3, Parent = self._contentArea,
        })
        Create("UIListLayout", { Padding = UDim.new(0, mobile and 6 or 4), SortOrder = Enum.SortOrder.LayoutOrder, Parent = ContentScroll })
        AddPadding(ContentScroll, 6, 6, 6, 6)

        local tabInfo = { btn = TabBtn, content = ContentScroll, order = #self._tabs + 1 }
        table.insert(self._tabs, tabInfo)

        local function SelectThis()
            for _, ti in ipairs(self._tabs) do
                Tween(ti.btn, {BackgroundColor3 = t.TabInactive}, 0.2, Enum.EasingStyle.Sine)
                ti.btn.TextColor3 = t.TextSecondary
                ti.btn:FindFirstChild("ActiveBar").Visible = false
                ti.content.Visible = false
            end
            Tween(TabBtn, {BackgroundColor3 = t.TabActive}, 0.2, Enum.EasingStyle.Sine)
            TabBtn.TextColor3 = t.TextPrimary
            ActiveBar.Visible = true
            ContentScroll.Visible = true
            self._activeTab = tabInfo
        end

        TabBtn.MouseButton1Click:Connect(SelectThis)
        TabBtn.MouseEnter:Connect(function()
            if self._activeTab ~= tabInfo then
                Tween(TabBtn, {BackgroundColor3 = t.TertiaryBG}, 0.18, Enum.EasingStyle.Sine)
                TabBtn.TextColor3 = t.TextHover
            end
        end)
        TabBtn.MouseLeave:Connect(function()
            if self._activeTab ~= tabInfo then
                Tween(TabBtn, {BackgroundColor3 = t.TabInactive}, 0.18, Enum.EasingStyle.Sine)
                TabBtn.TextColor3 = t.TextSecondary
            end
        end)

        if #self._tabs == 1 then SelectThis() end

        -- ══════════════════════════════════════════════
        --              TAB API OBJECT
        -- ══════════════════════════════════════════════
