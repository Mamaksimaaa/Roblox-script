    local themeIdx   = 1
    ThemeBtn.MouseButton1Click:Connect(function()
        themeIdx = (themeIdx % #themeOrder) + 1
        self:SetTheme(themeOrder[themeIdx])
    end)

    -- ── Keybind listener ──────────────────────────────
    UserInputService.InputBegan:Connect(function(input, gp)
        if gp then return end
        for _, kb in ipairs(self._keybinds) do
            if input.KeyCode == kb.key then
                pcall(kb.callback)
            end
        end
    end)

    -- ══════════════════════════════════════════════════
    --           WINDOW METHODS
    -- ══════════════════════════════════════════════════

    function self:SetTheme(name)
        local t = Themes[name]
        if not t then return end
        self._theme = t

        -- Recolor main panels
        Main.BackgroundColor3          = t.Background
        TitleBar.BackgroundColor3      = t.SecondaryBG
        TabBar.BackgroundColor3        = t.SecondaryBG
        ContentArea.BackgroundColor3   = t.Background
        BottomBar.BackgroundColor3     = t.Accent
        TitleLabel.TextColor3          = t.Title
        CloseBtn.BackgroundColor3      = t.CloseBtn
        MinBtn.BackgroundColor3        = t.MinBtn
        ThemeBtn.BackgroundColor3      = t.TertiaryBG
        ThemeBtn.TextColor3            = t.TextSecondary

        -- Recolor pixel icons
        for i, pix in ipairs({PixelIcon}) do end -- refresh handled per-element below

        -- Update borders
        for _, s in ipairs(Main:GetDescendants()) do
            if s:IsA("UIStroke") then
                s.Color = t.Border
            end
        end

        -- Recolor tabs
        for _, tabInfo in ipairs(self._tabs) do
            local isActive = (tabInfo == self._activeTab)
            tabInfo.btn.BackgroundColor3 = isActive and t.TabActive or t.TabInactive
            tabInfo.btn.TextColor3       = isActive and t.TextPrimary or t.TextSecondary
            self:_recolorTab(tabInfo.content, t)
        end
    end

    function self:_recolorTab(frame, t)
        -- recolor all widgets inside a tab frame
        for _, el in ipairs(frame:GetDescendants()) do
            if el:IsA("TextLabel") then
                if el.Name == "ItemLabel" or el.Name == "ValueLabel" then
                    el.TextColor3 = t.TextPrimary
                elseif el.Name == "SecLabel" then
                    el.TextColor3 = t.TextSecondary
                end
            elseif el:IsA("TextButton") and el.Name == "ActionBtn" then
                el.BackgroundColor3 = t.Accent
                el.TextColor3       = t.TextPrimary
            elseif el:IsA("Frame") and el.Name == "SliderFill" then
                el.BackgroundColor3 = t.SliderFill
            elseif el:IsA("Frame") and el.Name == "SliderBG" then
                el.BackgroundColor3 = t.SliderBG
            elseif el:IsA("Frame") and el.Name == "ToggleTrack" then
                -- toggled state handled dynamically
            elseif el:IsA("Frame") and el.Name == "Separator" then
                el.BackgroundColor3 = t.Separator
            elseif el:IsA("UIStroke") then
                el.Color = t.Border
            end
        end
    end

    -- ════════════════════════════════════════════════
    --                  ADD TAB
    -- ════════════════════════════════════════════════

    function self:AddTab(name)
        local t = self._theme

        -- Tab button
        local TabBtn = Create("TextButton", {
            Name             = "Tab_" .. name,
            Size             = UDim2.new(1, 0, 0, 30),
            BackgroundColor3 = t.TabInactive,
            Text             = name,
            TextColor3       = t.TextSecondary,
            TextSize         = 12,
            Font             = Enum.Font.GothamBold,
            BorderSizePixel  = 0,
            LayoutOrder      = #self._tabs + 1,
            ZIndex           = 4,
            Parent           = self._tabList,
        })
        AddPixelBorder(TabBtn, t.Border, 1)

        -- Active left accent bar
        local ActiveBar = Create("Frame", {
            Name             = "ActiveBar",
            Size             = UDim2.new(0, 3, 1, 0),
            BackgroundColor3 = t.Accent,
            BorderSizePixel  = 0,
            Visible          = false,
            ZIndex           = 5,
            Parent           = TabBtn,
        })

        -- Scroll frame for content
        local ContentScroll = Create("ScrollingFrame", {
            Name                      = "TabContent_" .. name,
            Size                      = UDim2.new(1, 0, 1, 0),
            BackgroundTransparency    = 1,
            BorderSizePixel           = 0,
            ScrollBarThickness        = 3,
            ScrollBarImageColor3      = t.Scrollbar,
            CanvasSize                = UDim2.new(0, 0, 0, 0),
            AutomaticCanvasSize       = Enum.AutomaticSize.Y,
            Visible                   = false,
            ZIndex                    = 3,
            Parent                    = ContentArea,
        })
        Create("UIListLayout", {
            Padding   = UDim.new(0, 4),
            SortOrder = Enum.SortOrder.LayoutOrder,
            Parent    = ContentScroll,
        })
        AddPadding(ContentScroll, 6, 6, 8, 8)

        local tabInfo = {
            btn     = TabBtn,
            content = ContentScroll,
            order   = #self._tabs + 1,
        }
        table.insert(self._tabs, tabInfo)

        local function SelectThis()
            -- Deactivate all
            for _, ti in ipairs(self._tabs) do
                Tween(ti.btn, {BackgroundColor3 = t.TabInactive}, 0.12)
                ti.btn.TextColor3 = t.TextSecondary
                ti.btn:FindFirstChild("ActiveBar").Visible = false
                ti.content.Visible = false
            end
            -- Activate this
            Tween(TabBtn, {BackgroundColor3 = t.TabActive}, 0.12)
            TabBtn.TextColor3 = t.TextPrimary
            ActiveBar.Visible = true
            ContentScroll.Visible = true
            self._activeTab = tabInfo
        end

        TabBtn.MouseButton1Click:Connect(SelectThis)
        TabBtn.MouseEnter:Connect(function()
            if self._activeTab ~= tabInfo then
                Tween(TabBtn, {BackgroundColor3 = t.TertiaryBG}, 0.1)
            end
        end)
        TabBtn.MouseLeave:Connect(function()
            if self._activeTab ~= tabInfo then
