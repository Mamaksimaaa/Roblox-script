            -- Container for section items
            local SectionFrame = Create("Frame", {
                Size             = UDim2.new(1, 0, 0, 0),
                AutomaticSize    = Enum.AutomaticSize.Y,
                BackgroundTransparency = 1,
                LayoutOrder      = NextOrder(),
                ZIndex           = 4,
                Parent           = ContentScroll,
            })
            Create("UIListLayout", {
                Padding   = UDim.new(0, 4),
                SortOrder = Enum.SortOrder.LayoutOrder,
                Parent    = SectionFrame,
            })
            AddPadding(SectionFrame, 0, 0, 8, 0)

            Header.MouseButton1Click:Connect(function()
                open = not open
                SectionFrame.Visible = open
                Header.Text = (open and "▼  " or "▶  ") .. text
            end)

            -- Return a mini-tab API for section items
            local secTab = {}
            local secOrder = 0

            local function SMAkeItem(h)
                local t3 = self._theme
                local r = Create("Frame", {
                    Size             = UDim2.new(1, -4, 0, h or 32),
                    BackgroundColor3 = t3.SecondaryBG,
                    BorderSizePixel  = 0,
                    LayoutOrder      = secOrder,
                    ZIndex           = 5,
                    Parent           = SectionFrame,
                })
                secOrder = secOrder + 1
                AddPixelBorder(r, t3.Border, 1)
                return r
            end

            -- proxy AddButton / AddToggle into section
            for k, v in pairs(Tab) do
                if type(v) == "function" then
                    secTab[k] = function(_, ...)
                        -- swap parent row to SectionFrame
                        -- quick patch: use SMAkeItem
                        return v(Tab, ...)
                    end
                end
            end

            return secTab
        end

        -- ────────────────────────────────────────────
        -- NOTIFY (from tab)
        -- ────────────────────────────────────────────
        function Tab:AddNotify(title, msg, duration)
            self._notify(title, msg, duration)
        end

        -- Wire parent notify
        Tab._notify = function(title, msg, duration)
            self:Notify(title, msg, duration)
        end

        return Tab
    end

    -- ══════════════════════════════════════════════════
    --              GLOBAL NOTIFY
    -- ══════════════════════════════════════════════════

    function self:Notify(title, message, duration)
        local t = self._theme
        duration = duration or 4

        local notif = Create("Frame", {
            Size             = UDim2.new(1, 0, 0, 0),
            AutomaticSize    = Enum.AutomaticSize.Y,
            BackgroundColor3 = t.Notification,
            BorderSizePixel  = 0,
            BackgroundTransparency = 1,
            ZIndex           = 20,
            Parent           = NotifContainer,
        })
        AddPixelBorder(notif, t.NotifAccent, 2)

        -- Accent left stripe
        Create("Frame", {
            Size             = UDim2.new(0, 4, 1, 0),
            BackgroundColor3 = t.NotifAccent,
            BorderSizePixel  = 0,
            ZIndex           = 21,
            Parent           = notif,
        })

        local Inner = Create("Frame", {
            Size             = UDim2.new(1, -8, 0, 0),
            AutomaticSize    = Enum.AutomaticSize.Y,
            Position         = UDim2.new(0, 8, 0, 0),
            BackgroundTransparency = 1,
            ZIndex           = 21,
            Parent           = notif,
        })
        AddPadding(Inner, 6, 6, 4, 6)

        Create("TextLabel", {
            Size             = UDim2.new(1, 0, 0, 16),
            BackgroundTransparency = 1,
            Text             = "⛏ " .. title,
            TextColor3       = t.NotifAccent,
            TextSize         = 13,
            Font             = Enum.Font.GothamBold,
            TextXAlignment   = Enum.TextXAlignment.Left,
            ZIndex           = 22,
            Parent           = Inner,
        })

        Create("TextLabel", {
            Size             = UDim2.new(1, 0, 0, 0),
            AutomaticSize    = Enum.AutomaticSize.Y,
            Position         = UDim2.new(0, 0, 0, 18),
            BackgroundTransparency = 1,
            Text             = message,
            TextColor3       = t.TextSecondary,
            TextSize         = 11,
            Font             = Enum.Font.Gotham,
            TextXAlignment   = Enum.TextXAlignment.Left,
            TextWrapped      = true,
            ZIndex           = 22,
            Parent           = Inner,
        })

        -- Progress bar
        local ProgBG = Create("Frame", {
            Size             = UDim2.new(1, 0, 0, 2),
            Position         = UDim2.new(0, 0, 1, -2),
            BackgroundColor3 = t.SliderBG,
            BorderSizePixel  = 0,
            ZIndex           = 22,
            Parent           = notif,
        })
        local Prog = Create("Frame", {
            Size             = UDim2.new(1, 0, 1, 0),
            BackgroundColor3 = t.NotifAccent,
            BorderSizePixel  = 0,
            ZIndex           = 23,
            Parent           = ProgBG,
        })

        -- Animate in
        Tween(notif, {BackgroundTransparency = 0}, 0.3)

        -- Progress bar countdown
        Tween(Prog, {Size = UDim2.new(0, 0, 1, 0)}, duration, Enum.EasingStyle.Linear)

        -- Animate out & destroy
        task.delay(duration, function()
            Tween(notif, {BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0)}, 0.3)
            task.delay(0.35, function()
                notif:Destroy()
            end)
        end)
    end

    -- ══════════════════════════════════════════════════
    --              DESTROY
    -- ══════════════════════════════════════════════════

    function self:Destroy()
        self._gui:Destroy()
    end

    return self
end

-- ═══════════════════════════════════════════════════════
--                  RETURN LIBRARY
-- ═══════════════════════════════════════════════════════

return MinecraftLib

