    function self:SetTheme(name)
        local t = Themes[name]
        if not t then return end
        self._theme = t

        Main.BackgroundColor3        = t.Background
        TitleBar.BackgroundColor3    = t.TertiaryBG
        TabBar.BackgroundColor3      = t.SecondaryBG
        ContentArea.BackgroundColor3 = t.Background
        BottomBar.BackgroundColor3   = t.Accent
        TitleLabel.TextColor3        = t.Title
        CloseBtn.BackgroundColor3    = t.CloseBtn
        ThemeBtn.BackgroundColor3    = t.SecondaryBG
        ThemeBtn.TextColor3          = t.TextSecondary
        Shadow.BackgroundColor3      = t.Shadow

        for _, tex in ipairs({Main, ContentArea}) do
            local bt = tex:FindFirstChild("BlockTexture")
            if bt then bt:Destroy() end
        end
        AddBlockTexture(Main, t, self._mobile and 10 or 16, self._mobile and 8 or 12, 0.75)
        AddBlockTexture(ContentArea, t, self._mobile and 8 or 12, self._mobile and 8 or 10, 0.85)
        Main:FindFirstChild("BlockTexture").ZIndex = 0

        for _, s in ipairs(Main:GetDescendants()) do
            if s:IsA("UIStroke") then
                s.Color = t.Border
            elseif s.Name == "BevelTop" or s.Name == "BevelLeft" then
                s.BackgroundColor3 = t.BevelLight
            elseif s.Name == "BevelBottom" or s.Name == "BevelRight" then
                s.BackgroundColor3 = t.BevelDark
            end
        end

        for _, tabInfo in ipairs(self._tabs) do
            local isActive = (tabInfo == self._activeTab)
            tabInfo.btn.BackgroundColor3 = isActive and t.TabActive or t.TabInactive
            tabInfo.btn.TextColor3 = isActive and t.TextPrimary or t.TextSecondary
            self:_recolorTab(tabInfo.content, t)
        end
    end

    function self:_recolorTab(frame, t)
        for _, el in ipairs(frame:GetDescendants()) do
            if el:IsA("TextLabel") or el:IsA("TextButton") then
                if el.Name == "ItemLabel" or el.Name == "ValueLabel" then
                    el.TextColor3 = t.TextPrimary
                elseif el.Name == "SecLabel" then
                    el.TextColor3 = t.TextSecondary
                elseif el.Name == "ActionBtn" then
                    el.BackgroundColor3 = t.Accent
                    el.TextColor3 = t.TextPrimary
                end
            elseif el:IsA("Frame") then
                if el.Name == "SliderFill" then el.BackgroundColor3 = t.SliderFill
                elseif el.Name == "SliderBG" then el.BackgroundColor3 = t.SliderBG
                elseif el.Name == "Separator" then el.BackgroundColor3 = t.Separator
                elseif el.Name == "BevelTop" or el.Name == "BevelLeft" then el.BackgroundColor3 = t.BevelLight
                elseif el.Name == "BevelBottom" or el.Name == "BevelRight" then el.BackgroundColor3 = t.BevelDark
                end
            elseif el:IsA("UIStroke") then
                el.Color = t.Border
            end
        end
    end

