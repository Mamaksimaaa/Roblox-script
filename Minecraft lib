function MinecraftLib:CreateWindow(title, config)
    config = config or {}
    local self = setmetatable({}, MinecraftLib)
    self._theme     = Themes["Overworld"]
    self._tabs      = {}
    self._activeTab = nil
    self._visible   = true
    self._keybinds  = {}
    self._title     = title or "Minecraft UI"
    self._mobile    = IsMobile()

    EnsureNotifContainer()

    -- ── Адаптивные размеры окна: больше на ПК, компактнее на телефоне ──
    local WIN_W = self._mobile and 320 or 560
    local WIN_H = self._mobile and 250 or 400
    local TAB_W = self._mobile and 78  or 120
    local FONT_TITLE = self._mobile and 12 or 14
    local FONT_BODY  = self._mobile and 11 or 12

    self._winW, self._winH, self._tabW = WIN_W, WIN_H, TAB_W

    -- ScreenGui
    local ScreenGui = Create("ScreenGui", {
        Name = "MinecraftUI_" .. tostring(math.random(1, 99999)),
        ResetOnSpawn = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        Parent = CoreGui,
    })
    self._gui = ScreenGui

    -- Shadow
    local Shadow = Create("Frame", {
        Name = "Shadow", Size = UDim2.new(0, WIN_W + 8, 0, WIN_H + 8),
        Position = UDim2.new(0.5, -(WIN_W + 8) / 2, 0.5, -(WIN_H + 8) / 2),
        BackgroundColor3 = self._theme.Shadow, BackgroundTransparency = 0.35,
        BorderSizePixel = 0, ZIndex = 0, Parent = ScreenGui,
    })

    -- Main Window
    local Main = Create("Frame", {
        Name = "Main", Size = UDim2.new(0, WIN_W, 0, WIN_H),
        Position = UDim2.new(0.5, -WIN_W / 2, 0.5, -WIN_H / 2),
        BackgroundColor3 = self._theme.Background, BorderSizePixel = 0,
        ClipsDescendants = false, ZIndex = 1, Parent = ScreenGui,
    })
    AddBlockTexture(Main, self._theme, self._mobile and 10 or 16, self._mobile and 8 or 12, 0.75)
    PixelBevel(Main, self._theme, 2)
    self._main, self._shadow = Main, Shadow

    -- Масштаб окна под маленький экран (например, повёрнутый телефон)
    local UIScaleInst = Create("UIScale", { Scale = 1, Parent = Main })
    self._uiScale = UIScaleInst

    -- ── Title Bar (деревянная вывеска) ──────────────────
    local TitleBar = Create("Frame", {
        Name = "TitleBar", Size = UDim2.new(1, 0, 0, self._mobile and 30 or 36),
        BackgroundColor3 = self._theme.TertiaryBG, BorderSizePixel = 0,
        ZIndex = 2, Parent = Main,
    })
    PixelBevel(TitleBar, self._theme, 2)

    -- Иконка блока травы (зелёный верх + земля снизу) вместо простых квадратов
