        function Tab:AddColorPicker(text, default, callback)
            local t2   = self._theme
            local row  = MakeItem(32)
            local col  = default or Color3.fromRGB(255, 0, 0)
            local open = false

            Create("TextLabel", {
                Name             = "ItemLabel",
