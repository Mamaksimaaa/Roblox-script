        -- ────────────────────────────────────────────
        function Tab:AddKeybind(text, defaultKey, callback)
            local t2       = self._theme
            local row      = MakeItem(32)
            local key      = defaultKey
            local listening = false

            Create("TextLabel", {
                Name             = "ItemLabel",
                Size             = UDim2.new(0.55, 0, 1, 0),
                Position         = UDim2.new(0, 8, 0, 0),
                BackgroundTransparency = 1,
                Text             = text,
                TextColor3       = t2.TextPrimary,
                TextSize         = 12,
                Font             = Enum.Font.Gotham,
                TextXAlignment   = Enum.TextXAlignment.Left,
                ZIndex           = 5,
                Parent           = row,
            })

            local KeyBtn = Create("TextButton", {
                Size             = UDim2.new(0, 72, 0, 22),
                Position         = UDim2.new(1, -80, 0.5, -11),
                BackgroundColor3 = t2.TertiaryBG,
                Text             = key and key.Name or "None",
                TextColor3       = t2.Accent,
                TextSize         = 11,
                Font             = Enum.Font.GothamBold,
                BorderSizePixel  = 0,
                ZIndex           = 5,
                Parent           = row,
            })
            AddPixelBorder(KeyBtn, t2.Border, 1)

            KeyBtn.MouseButton1Click:Connect(function()
                if listening then return end
                listening = true
                KeyBtn.Text      = "..."
                KeyBtn.TextColor3 = t2.AccentHover
                local con
                con = UserInputService.InputBegan:Connect(function(inp, gp)
                    if gp then return end
                    if inp.UserInputType == Enum.UserInputType.Keyboard then
                        key = inp.KeyCode
                        KeyBtn.Text = inp.KeyCode.Name
                        KeyBtn.TextColor3 = t2.Accent
                        listening = false
                        con:Disconnect()
                        -- register
                        for i, kb in ipairs(self._keybinds) do
                            if kb.id == text then
                                table.remove(self._keybinds, i)
                                break
                            end
                        end
                        table.insert(self._keybinds, {id = text, key = key, callback = callback})
                    end
                end)
            end)

            -- Register default keybind
            if key then
                table.insert(self._keybinds, {id = text, key = key, callback = callback})
            end

            local kb = {}
            function kb:Get() return key end
            return kb
        end

