    PixelBevel(ThemeBtn, self._theme, 1)

    -- ── Tab Bar ────────────────────────────────────────
    local TabBar = Create("Frame", {
        Name = "TabBar", Size = UDim2.new(0, TAB_W, 1, -(self._mobile and 30 or 36)),
        Position = UDim2.new(0, 0, 0, self._mobile and 30 or 36),
        BackgroundColor3 = self._theme.SecondaryBG, BorderSizePixel = 0,
        ZIndex = 2, Parent = Main,
    })
    PixelBevel(TabBar, self._theme, 2)

    local TabList = Create("Frame", {
        Name = "TabList", Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1, ZIndex = 3, Parent = TabBar,
    })
    Create("UIListLayout", { Padding = UDim.new(0, 3), SortOrder = Enum.SortOrder.LayoutOrder, Parent = TabList })
    AddPadding(TabList, 4, 4, 4, 4)
    self._tabList = TabList

    -- ── Content Area ───────────────────────────────────
    local ContentArea = Create("Frame", {
        Name = "Content", Size = UDim2.new(1, -TAB_W - 4, 1, -(self._mobile and 32 or 40)),
        Position = UDim2.new(0, TAB_W + 2, 0, (self._mobile and 32 or 38)),
        BackgroundColor3 = self._theme.Background, BorderSizePixel = 0,
        ZIndex = 2, Parent = Main,
    })
    AddBlockTexture(ContentArea, self._theme, self._mobile and 8 or 12, self._mobile and 8 or 10, 0.85)
    self._contentArea = ContentArea

    -- ── Pixel Decoration Line ──────────────────────────
    Create("Frame", {
        Size = UDim2.new(0, 2, 1, -(self._mobile and 32 or 38)),
        Position = UDim2.new(0, TAB_W, 0, (self._mobile and 32 or 38)),
        BackgroundColor3 = self._theme.Border, BorderSizePixel = 0,
        ZIndex = 3, Parent = Main,
    })

    -- ── Pixel bottom bar (полоса-акцент как хотбар) ────
    local BottomBar = Create("Frame", {
        Size = UDim2.new(1, 0, 0, 4), Position = UDim2.new(0, 0, 1, -4),
        BackgroundColor3 = self._theme.Accent, BorderSizePixel = 0,
        ZIndex = 3, Parent = Main,
    })
    self._bottomBar = BottomBar

    -- ── Make Draggable (мышь + палец) ──────────────────
    MakeDraggable(Main, TitleBar)
    Main:GetPropertyChangedSignal("Position"):Connect(function()
        Shadow.Position = UDim2.new(
            Main.Position.X.Scale, Main.Position.X.Offset + 4,
            Main.Position.Y.Scale, Main.Position.Y.Offset + 4
        )
    end)

    -- ── Button Hovers (жёлтый текст-ховер, как в меню MC) ──
    CloseBtn.MouseEnter:Connect(function() Tween(CloseBtn, {BackgroundColor3 = Color3.fromRGB(220, 80, 70)}, 0.18, Enum.EasingStyle.Sine) end)
    CloseBtn.MouseLeave:Connect(function() Tween(CloseBtn, {BackgroundColor3 = self._theme.CloseBtn}, 0.18, Enum.EasingStyle.Sine) end)
    CloseBtn.MouseButton1Click:Connect(function()
        Tween(Main, {Size = UDim2.new(0, 0, 0, 0),
            Position = UDim2.new(Main.Position.X.Scale, Main.Position.X.Offset + WIN_W / 2, Main.Position.Y.Scale, Main.Position.Y.Offset + WIN_H / 2)}, 0.32, Enum.EasingStyle.Back, Enum.EasingDirection.In)
        Tween(Shadow, {BackgroundTransparency = 1}, 0.28, Enum.EasingStyle.Sine)
        task.delay(0.34, function() ScreenGui:Destroy() end)
    end)

    -- ── Theme Cycling (Overworld -> Nether -> End) ─────
    local themeOrder = {"Overworld", "Nether", "End"}
    local themeIdx = 1
    ThemeBtn.MouseButton1Click:Connect(function()
        themeIdx = (themeIdx % #themeOrder) + 1
        self:SetTheme(themeOrder[themeIdx])
    end)

    -- ── Keybind listener (пользовательские бинды) ──────
    UserInputService.InputBegan:Connect(function(input, gp)
        if gp then return end
        for _, kb in ipairs(self._keybinds) do
            if input.KeyCode == kb.key then pcall(kb.callback) end
        end
    end)

    -- ══════════════════════════════════════════════════
    --      ПОКАЗАТЬ/СКРЫТЬ ОКНО (RightShift на ПК,
    --      плавающая кнопка на телефоне)
    -- ══════════════════════════════════════════════════

    function self:ToggleVisible()
        self._visible = not self._visible
        if self._visible then
            Main.Visible, Shadow.Visible = true, true
            Main.Size = UDim2.new(0, 0, 0, 0)
            Tween(Main, {Size = UDim2.new(0, WIN_W, 0, WIN_H)}, 0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
            Tween(Shadow, {BackgroundTransparency = 0.35}, 0.3, Enum.EasingStyle.Sine)
        else
            Tween(Main, {Size = UDim2.new(0, 0, 0, 0)}, 0.22, Enum.EasingStyle.Back, Enum.EasingDirection.In)
            Tween(Shadow, {BackgroundTransparency = 1}, 0.2, Enum.EasingStyle.Sine)
            task.delay(0.23, function()
                if not self._visible then Main.Visible, Shadow.Visible = false, false end
            end)
        end
    end

    if not self._mobile then
        -- ПК: бинд на RightShift
        UserInputService.InputBegan:Connect(function(input, gp)
            if input.KeyCode == Enum.KeyCode.RightShift then
                self:ToggleVisible()
            end
        end)
    else
        -- Телефон: плавающая пиксельная кнопка-переключатель (клавиатуры нет)
        local ToggleBtn = Create("TextButton", {
            Name = "MC_MobileToggle", Size = UDim2.new(0, 44, 0, 44),
            Position = UDim2.new(1, -56, 1, -110),
            BackgroundColor3 = self._theme.TertiaryBG, Text = "M",
            TextColor3 = self._theme.TextPrimary, TextSize = 16,
            Font = Enum.Font.Arcade, BorderSizePixel = 0,
            ZIndex = 50, Parent = ScreenGui,
        })
        PixelText(ToggleBtn)
        PixelBevel(ToggleBtn, self._theme, 2)
        MakeDraggable(ToggleBtn, ToggleBtn)
        ToggleBtn.MouseButton1Click:Connect(function() self:ToggleVisible() end)
        self._mobileToggle = ToggleBtn
    end

    -- ── Адаптация под изменение размера экрана/поворот ─
    local function AdjustToViewport()
        local vp = Camera.ViewportSize
        local scale = math.clamp(math.min(vp.X / (WIN_W + 40), vp.Y / (WIN_H + 40), 1), 0.55, 1)
        Tween(UIScaleInst, {Scale = scale}, 0.15)
    end
    Camera:GetPropertyChangedSignal("ViewportSize"):Connect(AdjustToViewport)
    AdjustToViewport()

