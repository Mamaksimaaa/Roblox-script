        Font = Enum.Font.Arcade, BorderSizePixel = 0, ZIndex = 4, Parent = TitleBar,
    })
    PixelText(CloseBtn)
    PixelBevel(CloseBtn, self._theme, 1)

    -- Theme selector button (переключение измерений) — теперь на месте бывшей кнопки сворачивания
    local ThemeBtn = Create("TextButton", {
        Name = "Theme", Size = UDim2.new(0, self._mobile and 50 or 60, 0, self._mobile and 18 or 20),
        Position = UDim2.new(1, -BtnSize - (self._mobile and 58 or 70), 0.5, -(self._mobile and 9 or 10)),
