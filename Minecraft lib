    local GrassIcon = Create("Frame", {
        Size = UDim2.new(0, IconSize, 0, IconSize),
        Position = UDim2.new(0, 8, 0.5, -IconSize / 2),
        BackgroundColor3 = Color3.fromRGB(92, 70, 48), BorderSizePixel = 0,
        ZIndex = 3, Parent = TitleBar,
    })
    PixelBevel(GrassIcon, self._theme, 1)
    Create("Frame", {
        Size = UDim2.new(1, -2, 0, math.floor(IconSize * 0.4)),
        Position = UDim2.new(0, 1, 0, 1),
        BackgroundColor3 = Color3.fromRGB(88, 156, 51), BorderSizePixel = 0,
        ZIndex = 4, Parent = GrassIcon,
    })

    local TitleLabel = Create("TextLabel", {
        Name = "Title", Size = UDim2.new(1, -120, 1, 0),
        Position = UDim2.new(0, IconSize + 16, 0, 0),
        BackgroundTransparency = 1, Text = title or "Minecraft UI",
        TextColor3 = self._theme.Title, TextSize = FONT_TITLE,
        Font = Enum.Font.Arcade, TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 3, Parent = TitleBar,
    })
    PixelText(TitleLabel)
    self._titleLabel = TitleLabel

    -- Close Button
    local BtnSize = self._mobile and 24 or 26
