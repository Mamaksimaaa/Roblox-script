                Parent           = row,
            })

            local Preview = Create("Frame", {
                Size             = UDim2.new(0, 24, 0, 20),
                Position         = UDim2.new(1, -32, 0.5, -10),
                BackgroundColor3 = col,
                BorderSizePixel  = 0,
                ZIndex           = 5,
                Parent           = row,
            })
            AddPixelBorder(Preview, t2.Border, 2)

            -- Color picker popup (3x3 palette + HSV basic)
            local Popup = Create("Frame", {
                Size             = UDim2.new(0, 180, 0, 130),
                Position         = UDim2.new(1, -185, 1, 4),
                BackgroundColor3 = t2.SecondaryBG,
                BorderSizePixel  = 0,
                ZIndex           = 12,
                Visible          = false,
                Parent           = row,
            })
            AddPixelBorder(Popup, t2.Accent, 1)

            -- Preset colors grid
            local presets = {
                Color3.fromRGB(255,0,0),   Color3.fromRGB(255,128,0), Color3.fromRGB(255,255,0),
                Color3.fromRGB(0,255,0),   Color3.fromRGB(0,255,255), Color3.fromRGB(0,0,255),
                Color3.fromRGB(128,0,255), Color3.fromRGB(255,0,255), Color3.fromRGB(255,255,255),
                Color3.fromRGB(0,0,0),     Color3.fromRGB(128,128,128), Color3.fromRGB(204,0,204),
            }
            for i, pc in ipairs(presets) do
                local col_x = ((i-1) % 6) * 28 + 4
                local col_y = math.floor((i-1) / 6) * 28 + 4
                local swatch = Create("TextButton", {
                    Size             = UDim2.new(0, 22, 0, 22),
                    Position         = UDim2.new(0, col_x, 0, col_y),
                    BackgroundColor3 = pc,
                    Text             = "",
                    BorderSizePixel  = 0,
                    ZIndex           = 13,
                    Parent           = Popup,
                })
                AddPixelBorder(swatch, t2.Border, 1)
                swatch.MouseButton1Click:Connect(function()
                    col = pc
                    Preview.BackgroundColor3 = col
                    Popup.Visible = false
                    open = false
                    pcall(callback, col)
                end)
            end

            -- RGB sliders
            local function makeRGBSlider(label, posY, getVal, setVal)
                Create("TextLabel", {
                    Size             = UDim2.new(0, 14, 0, 12),
                    Position         = UDim2.new(0, 4, 0, posY),
                    BackgroundTransparency = 1,
                    Text             = label,
                    TextColor3       = t2.TextSecondary,
                    TextSize         = 9,
                    Font             = Enum.Font.GothamBold,
                    ZIndex           = 13,
                    Parent           = Popup,
                })
                local bg = Create("Frame", {
                    Size             = UDim2.new(0, 130, 0, 8),
                    Position         = UDim2.new(0, 20, 0, posY + 2),
                    BackgroundColor3 = t2.SliderBG,
                    BorderSizePixel  = 0,
                    ZIndex           = 13,
                    Parent           = Popup,
                })
                AddPixelBorder(bg, t2.Border, 1)
                local fill = Create("Frame", {
                    Size             = UDim2.new(getVal(), 0, 1, 0),
                    BackgroundColor3 = t2.Accent,
                    BorderSizePixel  = 0,
                    ZIndex           = 14,
                    Parent           = bg,
                })
                local draggingRGB = false
                bg.InputBegan:Connect(function(inp)
                    if inp.UserInputType == Enum.UserInputType.MouseButton1 then draggingRGB = true end
                end)
                UserInputService.InputEnded:Connect(function(inp)
                    if inp.UserInputType == Enum.UserInputType.MouseButton1 then draggingRGB = false end
                end)
                UserInputService.InputChanged:Connect(function(inp)
                    if draggingRGB and inp.UserInputType == Enum.UserInputType.MouseMovement then
                        local r = math.clamp((inp.Position.X - bg.AbsolutePosition.X) / bg.AbsoluteSize.X, 0, 1)
                        fill.Size = UDim2.new(r, 0, 1, 0)
                        setVal(r)
                        Preview.BackgroundColor3 = col
                        pcall(callback, col)
                    end
                end)
            end

            local r, g, b = col.R, col.G, col.B
            makeRGBSlider("R", 66, function() return r end, function(v) r=v col=Color3.new(r,g,b) end)
            makeRGBSlider("G", 84, function() return g end, function(v) g=v col=Color3.new(r,g,b) end)
            makeRGBSlider("B", 102, function() return b end, function(v) b=v col=Color3.new(r,g,b) end)

            local OpenBtn = Create("TextButton", {
                Size             = UDim2.new(1, 0, 1, 0),
                BackgroundTransparency = 1,
                Text             = "",
                ZIndex           = 6,
                Parent           = Preview,
            })
            OpenBtn.MouseButton1Click:Connect(function()
                open = not open
                Popup.Visible = open
            end)

            local cp = {}
            function cp:Set(c)
                col = c
                Preview.BackgroundColor3 = c
                pcall(callback, c)
            end
            function cp:Get() return col end
            return cp
        end

